# copy this file to .env and fill in only the credentials you have

# openai api key (primary + fallback agent model). required for a live run;
# the offline test suite uses a scripted model and needs no key
OPENAI_API_KEY=

# model config (ids verified against developers.openai.com/api/docs/models,
# 2026-09-20; both support function calling, which the tool loop needs)
# gpt-5.6-sol = flagship tier; gpt-5.4-mini = fast/cheap fallback
LICET_AGENT_MODEL=gpt-5.6-sol
LICET_FALLBACK_MODEL=gpt-5.4-mini
# none|low|medium|high|xhigh|max (blank = provider default)
LICET_REASONING_EFFORT=
LICET_MODEL_TIMEOUT=120
LICET_MODEL_RETRIES=2

# solari (cloud browser sdk) — key from console.getsolari.com (slr_live_...)
# python sdk: pip install solari-browser  → from solari_browser import solari
# sessions are playwright-compatible; see docs/accela_ui_map.md for the
# profile/storagestate gotcha that matters for the accela login account
SOLARI_API_KEY=
SOLARI_BASE_URL=

# accela target. note: two different accounts exist —
#   1. accela developer account (api access): under review; not required for
#      licet v1's browser path. only useful later as eval ground truth
#   2. aca public-user account (free, self-registered on the portal): this is
#      what inspection scheduling needs. fill accela_test_* with it
ACCELA_SANDBOX_URL=https://aca-test.accela.com/nullisland/Default.aspx
ACCELA_TEST_USERNAME=
ACCELA_TEST_PASSWORD=

# agent limits
LICET_MAX_STEPS=25
